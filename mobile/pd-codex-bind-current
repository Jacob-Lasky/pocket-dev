#!/usr/bin/env node
// One-time migration helper for Codex tabs started before per-tab capture
// existed. A tool can run inside a multi-agent child thread, so resolve its
// supported App Server record before choosing the resumable conversation.
const path = require('node:path');
const { spawn, spawnSync } = require('node:child_process');
const { SAFE_ID, UUID_RE } = require('./safeId');

const APP_SERVER_TIMEOUT_MS = 10_000;
const MAX_PROTOCOL_LINE_BYTES = 1024 * 1024;
const MAX_PARENT_DEPTH = 32;

function stop(child) {
  child.stdin.end();
  child.kill('SIGTERM');
}

function resolveResumeId(threadId) {
  return new Promise((resolve, reject) => {
    const child = spawn('codex', ['app-server', '--stdio'], {
      env: process.env,
      stdio: ['pipe', 'pipe', 'ignore'],
    });
    let buffer = '';
    let settled = false;
    let currentThreadId = threadId;
    let readRequestId = 2;
    const visited = new Set([threadId]);

    const timeout = setTimeout(() => finish(new Error('timeout')), APP_SERVER_TIMEOUT_MS);

    function finish(error, result) {
      if (settled) return;
      settled = true;
      clearTimeout(timeout);
      stop(child);
      if (error) reject(error);
      else resolve(result);
    }

    function send(message) {
      child.stdin.write(`${JSON.stringify(message)}\n`);
    }

    function acceptThread(message, expectedId) {
      if (message.error) throw new Error('app-server error');
      const thread = message.result?.thread;
      if (!thread || thread.id !== expectedId || !UUID_RE.test(thread.sessionId || '')) {
        throw new Error('invalid thread record');
      }
      if (thread.parentThreadId != null && !UUID_RE.test(thread.parentThreadId)) {
        throw new Error('invalid parent thread');
      }
      return thread;
    }

    function readThread() {
      send({
        method: 'thread/read',
        id: readRequestId,
        params: { threadId: currentThreadId, includeTurns: false },
      });
    }

    function receive(message) {
      if (message.id === 1) {
        if (message.error) throw new Error('initialize failed');
        send({ method: 'initialized', params: {} });
        readThread();
        return;
      }

      if (message.id === readRequestId) {
        const thread = acceptThread(message, currentThreadId);
        if (thread.parentThreadId == null) {
          finish(null, thread.id);
          return;
        }

        if (visited.size >= MAX_PARENT_DEPTH || visited.has(thread.parentThreadId)) {
          throw new Error('invalid parent chain');
        }
        currentThreadId = thread.parentThreadId;
        visited.add(currentThreadId);
        readRequestId += 1;
        readThread();
      }
    }

    child.once('error', error => finish(error));
    child.stdin.on('error', error => finish(error));
    child.once('exit', () => {
      if (!settled) finish(new Error('app-server exited'));
    });
    child.stdout.setEncoding('utf8');
    child.stdout.on('data', chunk => {
      if (settled) return;
      buffer += chunk;

      for (;;) {
        const newline = buffer.indexOf('\n');
        if (newline < 0) break;
        const line = buffer.slice(0, newline);
        buffer = buffer.slice(newline + 1);
        if (!line.trim()) continue;
        if (Buffer.byteLength(line) > MAX_PROTOCOL_LINE_BYTES) {
          finish(new Error('protocol line too large'));
          return;
        }
        try {
          receive(JSON.parse(line));
        } catch (error) {
          finish(error);
          return;
        }
        if (settled) return;
      }
      if (Buffer.byteLength(buffer) > MAX_PROTOCOL_LINE_BYTES) {
        finish(new Error('protocol line too large'));
      }
    });

    send({
      method: 'initialize',
      id: 1,
      params: {
        clientInfo: {
          name: 'pocket-dev-codex-migration',
          title: 'pocket-dev Codex migration',
          version: '1',
        },
        capabilities: { experimentalApi: true },
      },
    });
  });
}

async function main() {
  const threadId = process.env.CODEX_THREAD_ID || '';
  if (!UUID_RE.test(threadId)) {
    throw new Error('Could not identify this Codex conversation.');
  }

  const tmux = spawnSync('tmux', ['display-message', '-p', '#S'], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  });
  const tmuxSession = tmux.status === 0 ? tmux.stdout.trim() : '';
  if (!SAFE_ID.test(tmuxSession)) {
    throw new Error('Could not identify this pocket-dev tab.');
  }

  let resumeId;
  try {
    resumeId = await resolveResumeId(threadId);
  } catch {
    throw new Error('Could not verify this Codex conversation with App Server.');
  }

  const stateDir = path.resolve(
    process.env.PD_STATE_DIR || path.join(process.env.HOME || '', '.pocket-dev'),
  );
  const sidFile = path.join(stateDir, 'sids', `${tmuxSession}.uuid`);
  const hook = path.join(__dirname, 'pd-codex-session-start');
  const result = spawnSync(hook, [], {
    env: {
      ...process.env,
      PD_STATE_DIR: stateDir,
      PD_CODEX_SID_FILE: sidFile,
      PD_CODEX_REPLACE_BINDING: '1',
    },
    input: JSON.stringify({ session_id: resumeId, hook_event_name: 'SessionStart' }),
    encoding: 'utf8',
    stdio: ['pipe', 'ignore', 'ignore'],
  });
  if (result.status !== 0) {
    throw new Error('Could not save this Codex conversation binding.');
  }

  process.stdout.write('This Codex tab is ready to resume after the pocket-dev update.\n');
}

main().catch(error => {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
});
