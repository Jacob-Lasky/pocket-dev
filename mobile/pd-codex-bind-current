#!/usr/bin/env node
// One-time migration helper for Codex tabs started before per-tab capture
// existed. A tool can run inside a multi-agent child thread, so resolve its
// supported App Server record before choosing the resumable conversation.
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const { withCodexAppServer } = require('./codexAppServer');
const { SAFE_ID, UUID_RE } = require('./safeId');

const APP_SERVER_TIMEOUT_MS = 10_000;
const MAX_PARENT_DEPTH = 32;

function resolveResumeId(threadId) {
  return withCodexAppServer({
    clientInfo: {
      name: 'pocket-dev-codex-migration',
      title: 'pocket-dev Codex migration',
      version: '1',
    },
    timeoutMs: APP_SERVER_TIMEOUT_MS,
  }, async (request) => {
    let currentThreadId = threadId;
    const visited = new Set([threadId]);

    for (;;) {
      const result = await request('thread/read', {
        threadId: currentThreadId,
        includeTurns: false,
      });
      const thread = result?.thread;
      if (!thread || thread.id !== currentThreadId || !UUID_RE.test(thread.sessionId || '')) {
        throw new Error('invalid thread record');
      }
      if (thread.parentThreadId != null && !UUID_RE.test(thread.parentThreadId)) {
        throw new Error('invalid parent thread');
      }
      if (thread.parentThreadId == null) return thread.id;
      if (visited.size >= MAX_PARENT_DEPTH || visited.has(thread.parentThreadId)) {
        throw new Error('invalid parent chain');
      }
      currentThreadId = thread.parentThreadId;
      visited.add(currentThreadId);
    }
  });
}

async function main() {
  const threadId = process.env.CODEX_THREAD_ID || '';
  if (!UUID_RE.test(threadId)) {
    throw new Error('Could not identify this Codex conversation.');
  }

  const tmux = spawnSync('tmux', ['display-message', '-p', '#S'], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  });
  const tmuxSession = tmux.status === 0 ? tmux.stdout.trim() : '';
  if (!SAFE_ID.test(tmuxSession)) {
    throw new Error('Could not identify this pocket-dev tab.');
  }

  let resumeId;
  try {
    resumeId = await resolveResumeId(threadId);
  } catch {
    throw new Error('Could not verify this Codex conversation with App Server.');
  }

  const stateDir = path.resolve(
    process.env.PD_STATE_DIR || path.join(process.env.HOME || '', '.pocket-dev'),
  );
  const sidFile = path.join(stateDir, 'sids', `${tmuxSession}.uuid`);
  const hook = path.join(__dirname, 'pd-codex-session-start');
  const result = spawnSync(hook, [], {
    env: {
      ...process.env,
      PD_STATE_DIR: stateDir,
      PD_CODEX_SID_FILE: sidFile,
      PD_CODEX_REPLACE_BINDING: '1',
    },
    input: JSON.stringify({
      session_id: resumeId,
      hook_event_name: 'SessionStart',
      source: 'startup',
    }),
    encoding: 'utf8',
    stdio: ['pipe', 'ignore', 'ignore'],
  });
  if (result.status !== 0) {
    throw new Error('Could not save this Codex conversation binding.');
  }

  process.stdout.write('This Codex tab is ready to resume after the pocket-dev update.\n');
}

main().catch(error => {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
});
