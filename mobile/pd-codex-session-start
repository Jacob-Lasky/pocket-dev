#!/usr/bin/env node
// Managed Codex SessionStart hook. Codex supplies its supported session_id on
// stdin, and server.js supplies a destination for only pocket-dev Codex tabs.
// Ordinary Codex sessions have no destination and this exits without effects.
const fs = require('fs');
const path = require('path');
const { randomBytes } = require('node:crypto');
const { SAFE_ID, UUID_RE } = require('./safeId');

const SESSION_START_SOURCES = new Set(['startup', 'resume', 'clear', 'compact']);

const target = process.env.PD_CODEX_SID_FILE;

if (!target) process.exit(0);

const stateDir = path.resolve(
  process.env.PD_STATE_DIR || path.join(process.env.HOME || '', '.pocket-dev'),
);
const sidDir = path.join(stateDir, 'sids');
const resolvedTarget = path.resolve(target);
const sidName = path.basename(resolvedTarget);
const sessionId = sidName.endsWith('.uuid') ? sidName.slice(0, -5) : '';

if (path.dirname(resolvedTarget) !== sidDir || !SAFE_ID.test(sessionId)) {
  process.exit(1);
}

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', chunk => {
  input += chunk;
  if (input.length > 64 * 1024) process.exit(1);
});
process.stdin.on('end', () => {
  let event;
  try {
    event = JSON.parse(input);
  } catch {
    process.exit(1);
  }
  if (event?.hook_event_name !== 'SessionStart'
      || !UUID_RE.test(event?.session_id || '')
      || !SESSION_START_SOURCES.has(event?.source)) {
    process.exit(1);
  }

  const tmp = `${resolvedTarget}.${process.pid}.${randomBytes(12).toString('hex')}.tmp`;
  try {
    fs.mkdirSync(sidDir, { recursive: true, mode: 0o700 });
    fs.writeFileSync(tmp, `${event.session_id}\n`, { mode: 0o600, flag: 'wx' });
    if (process.env.PD_CODEX_REPLACE_BINDING === '1' || event.source === 'clear') {
      // The one-time migration helper has already resolved and verified the
      // root, while clear intentionally starts a new conversation in-place.
      // Both must replace the previous binding atomically.
      fs.renameSync(tmp, resolvedTarget);
    } else {
      // The launcher deletes the old binding before a genuinely fresh TUI
      // starts, so the first SessionStart is the root we must preserve. Later
      // lifecycle events in the same TUI can carry a non-resumable identity.
      // linkSync publishes the complete temp inode without replacing that root.
      try {
        fs.linkSync(tmp, resolvedTarget);
      } catch (error) {
        if (error.code !== 'EEXIST') throw error;
      }
      fs.rmSync(tmp);
    }
  } catch {
    try { fs.rmSync(tmp, { force: true }); } catch {}
    process.exit(1);
  }
});
