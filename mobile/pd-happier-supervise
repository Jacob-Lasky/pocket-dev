#!/bin/bash
# Keep the Happier daemon running for as long as this container runs.
#
# WHY this exists. The Happier daemon is what makes this container's sessions
# visible and drivable from the Happier phone, desktop and web apps: it holds
# the connection to the relay and launches sessions the apps ask for. Its own
# always-on mode (`happier daemon install`) is a `systemd --user` unit, and this
# container has no systemd, so without this loop the daemon runs only until the
# next recreate (CA Auto Update does one at ~03:00 whenever a new image exists)
# or the next crash, and nothing says it stopped.
#
# entrypoint.sh starts this in the background just before it execs the server,
# so it inherits the finished environment (LAVISH_AXI_HOST, CODEX_INSTALL_DIR,
# PATH) and hands it to the session runners it spawns. That is also why the daemon
# should be STARTED by this loop rather than by hand: a `happier daemon start`
# typed through `docker exec` builds its environment from the image config and
# misses those exports. After a first `happier auth login`, just wait for the
# next pass; the credential check below picks it up. The `claude` a runner
# starts still gets an allowlisted environment without those exports; the
# ~/.claude SessionStart hook pocket-dev-session-env.sh restores them (#103,
# CLAUDE.md "Happier daemon").
#
# The loop has no exit path (no `set -e`, nothing returns early) except the
# PD_HAPPIER_ONCE test seam, so the only way it stops is a signal. Under
# `--init` tini reaps whatever the daemon orphans.
#
# Status comes from `happier daemon status --json` and NOT the exit code, which
# is 0 whether or not the daemon runs (measured on CLI 0.2.16). Anything short
# of a completed call carrying BOOLEAN `auth.authenticated` and
# `daemon.running` is "unknown" and never triggers a start, so a CLI that
# cannot answer is never mistaken for a dead daemon. Two supervisors, or one
# racing a manual start, are harmless: `happier daemon start` against a live
# daemon prints "Daemon already running" and keeps the same PID (measured
# 2026-10-15).
#
# IT ALSO MOVES THE DAEMON ONTO A NEW CLI, because nothing else will. The CLI
# is the Happier-managed install (~/.happier, launcher ~/bin/happier), which
# the Happier app updates with `happier self update`. That command restarts the
# daemon only when a systemd or launchd service owns it; for a daemon started
# by hand, as this one is, it installs the new version and leaves the old
# daemon running (happier-dev/happier, restartServiceDaemonAfterUpdate.ts), so
# the app would keep showing the old version with its update "done". When the
# status reports `runtimeConvergence.cliVersionMatches: false` (the daemon was
# started by an older CLI than the one on PATH) and no service owns the daemon,
# this stops it and starts it again from the CLI on PATH, but only when that
# CLI is a strictly NEWER release (never a downgrade onto the image's npm
# fallback). `daemon stop` keeps the sessions running (its help: "sessions
# stay alive"); runners keep the old version's code until they end. One
# completed restart per (daemon version, CLI version) pair: if the daemon still
# reports the old version afterwards, it says so and does not restart in a
# loop. A stop that fails is retried on the next pass.
#
# IT ALSO CLEARS A DAEMON RECORD A PREVIOUS CONTAINER LEFT, right before it
# starts a daemon that is not running. ~/.happier outlives a recreate and the
# PID namespace does not, so the record can name a PID an unrelated process
# holds now, and Happier 0.2.17's start then dies on it (process_identity_unverified)
# after making `daemon start` wait 60 s. Only records written before this
# container's PID 1 started are removed; see clear_stale_daemon_records.
#
# IT ALSO RESUMES THIS MACHINE'S STANDING SUPERVISOR SESSION, ONCE PER BOOT.
# The supervisor (a Happier-managed Claude session in ~/supervisor, the
# `supervisor` skill) dies with the container, and nothing else here brings it
# back: it was down 14:27-14:54Z on 2026-11-03 after a recreate, and the
# nightly ~03:00 one has the same gap. The desktop and laptop run the same
# step from the systemd unit supervisor-autoresume.service; this container has
# no systemd, so this loop is its stand-in. The first time a pass sees the
# daemon signed in and running (or starts it), it launches, in the
# BACKGROUND so a pass is never held up,
#   python3 -I ~/.claude/skills/supervisor/scripts/fleet.py resume-self
# which itself waits until the daemon is registered and the relay answers,
# leaves a running supervisor alone ("already running"), skips a home with no
# supervisor profile, and holds a lock so two runs cannot both resume. Its one
# JSON outcome line reaches the container log prefixed
# "pocket-dev: supervisor-resume:". DO NOT run it on every pass or after a daemon restart: a
# supervisor Jake stopped on purpose must stay stopped until the next boot.
# Once per boot is a marker directory named for the host boot id and PID 1's
# start time under PD_SUPERVISOR_RESUME_DIR (/tmp/pocket-dev-supervisor-resume),
# claimed with an atomic mkdir: /tmp lives in the container layer, so it
# survives a `docker restart` (and a host reboot) that kills the supervisor,
# and the key is what changes then; a second copy of this loop started by hand
# in the same boot finds the marker and does nothing. A failed run is retried
# at most twice, PD_SUPERVISOR_RESUME_RETRY seconds apart (120, the unit's
# RestartSec); a run that found another resume-self holding the lock waits for
# it at the same spacing (up to 720 s from the first skip) without using up a
# retry; and
# resume-self reuses one pending localId, so a retry never queues a second
# startup message. No skill installed (a fresh home) is one log line.
# PD_SUPERVISOR_RESUME=0 turns it off.
#
# Logging is on STATE CHANGES only, to stderr (the container log); stdout
# belongs to whoever started us and entrypoint.sh points it at /dev/null.
#
# IT ALSO KEEPS EXTRA SERVER PROFILES' DAEMONS ALIVE, when asked to. A Happier
# daemon serves ONE server profile (~/.happier/servers/<id>/), and the plain
# `happier daemon ...` calls above all act on the ACTIVE profile. A machine
# paired with a second relay (Tower's `hypervisor` profile, 2026-11-05) needs a
# second daemon, and the CLI's way to keep that one up is
# `happier --server <id> service install`, which needs systemd too. So
# PD_HAPPIER_EXTRA_SERVERS (whitespace-separated profile ids, empty by default)
# names profiles this loop supervises ALONGSIDE the default daemon, each through
# `happier --server <id> daemon ...`. `--server` is a per-invocation prefix that
# the CLI documents as "no persistence", so the active profile never changes.
# Each extra gets the default daemon's rules: status from the JSON (and it must
# name that profile, or it is unknown), never a start on an unknown answer,
# stale-record clearing limited to servers/<id>/, the newer-CLI restart, and the
# environment this loop inherited. It does NOT get the supervisor resume, which
# belongs to the default daemon. An extra is skipped, with one log line, when it
# is not signed in, when its id is not a plain profile id, when it IS the active
# profile (the default daemon already covers it, and touching it from here
# would be touching the default daemon), and on any pass where the active
# profile could not be read, because then that last check cannot be made.
# Also skipped: a profile directory that is a symlink (it may be another
# profile's files), and every extra when the environment carries a variable
# that lets Happier pick the server or the daemon's state path itself.
#
# Two stated limits. (1) The active profile is read once per pass, from the
# default daemon's status, so switching the active profile in the moment
# between that read and an extra's turn makes that pass treat the new default
# daemon as the extra. It then applies the same rules the default pass would
# (start a stopped daemon, the newer-CLI restart) to the same daemon, without
# the supervisor resume, and the next pass skips it as the active profile.
# (2) The default daemon's pre-start clearing still covers every profile
# directory, as it always has, so it can clear an extra's record first. It
# only removes what no process in this container wrote (see
# clear_stale_daemon_records), which an extra's own pass would remove too.
#
# Knobs: PD_HAPPIER_INTERVAL (seconds between checks, default 60; anything that
# is not a number from 0.1 to 86400 falls back to 60, so a bad value cannot
# become a tight loop or an endless sleep), PD_HAPPIER_EXTRA_SERVERS (above)
# and PD_HAPPIER_ONCE=1 (one pass, then exit; the test seam).
set -u

INTERVAL="${PD_HAPPIER_INTERVAL:-60}"
# Between 0.1 s and a day: a positive but tiny value (1e-28 written out) slept
# for nothing and turned a failing start or stop into a tight loop, and a huge
# one (99999999999999999999) made `sleep` never return, so supervision
# silently stopped.
if ! [[ $INTERVAL =~ ^[0-9]+(\.[0-9]+)?$ ]] \
  || ! awk -v i="$INTERVAL" 'BEGIN { exit !(i >= 0.1 && i <= 86400) }'; then
  INTERVAL=60
fi
ONCE="${PD_HAPPIER_ONCE:-0}"
HAPPIER_HOME="${HAPPIER_HOME_DIR:-$HOME/.happier}"
# Per profile ("" is the default daemon): the last state logged, and the
# (daemon version, CLI version) pair a restart was last completed for.
declare -A last_key=() restarted_for=()
SCOPE=""      # the profile the current pass is about; "" for the default daemon
ACTIVE="-"    # the active profile id the default status reported this pass, or "-"
RESUME_SCRIPT="${PD_SUPERVISOR_RESUME_SCRIPT:-$HOME/.claude/skills/supervisor/scripts/fleet.py}"
RESUME_DIR="${PD_SUPERVISOR_RESUME_DIR:-/tmp/pocket-dev-supervisor-resume}"
RESUME_RETRY="${PD_SUPERVISOR_RESUME_RETRY:-120}"
if ! [[ $RESUME_RETRY =~ ^[0-9]+(\.[0-9]+)?$ ]] \
  || ! awk -v i="$RESUME_RETRY" 'BEGIN { exit !(i >= 0.1 && i <= 3600) }'; then
  RESUME_RETRY=120
fi
# How long a held lock is waited out, from the first skip of a streak: the
# holder's own 600 s timeout plus slack. Whole seconds (bash's SECONDS).
RESUME_LOCK_WAIT="${PD_SUPERVISOR_RESUME_LOCK_WAIT:-720}"
[[ $RESUME_LOCK_WAIT =~ ^[1-9][0-9]{0,4}$ ]] || RESUME_LOCK_WAIT=720
resume_checked=""

say() {
  # $1 is the state key, $2 the message. Same key twice in a row for the same
  # profile stays quiet, so profiles in different states cannot make each
  # other log on every pass. Extras are named in the prefix.
  [ "$1" = "${last_key[${SCOPE:-.}]:-}" ] && return 0
  last_key[${SCOPE:-.}]="$1"
  echo "pocket-dev: happier${SCOPE:+ [$SCOPE]}: $2" >&2
}

# A Happier server profile id this loop will pass to --server and use as a
# directory name under servers/: a letter or digit first (so never an option,
# ".", ".." or empty), then letters, digits, ".", "_" or "-". read_state hands
# this same pattern to node, whose RegExp reads it identically.
PROFILE_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'

# The happier CLI for the profile of the current pass, as an argv array (an
# array, not a function, because `timeout` runs a command): the default
# daemon's calls stay exactly `happier ...`; an extra's are
# `happier --server <id> ...`. Set by supervise_profile.
HP=(happier)

newer() {
  # True when release version $1 is strictly newer than $2. Both must be plain
  # N.N.N (Happier's stable releases); anything else is not provably newer.
  # No leading zeros, so equal versions are always equal strings.
  local re='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
  [[ $1 =~ $re && $2 =~ $re ]] || return 1
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

pid1_start_ticks() {
  # PID 1's start time: field 22 of /proc/1/stat, clock ticks since the HOST
  # booted. Read after the last ")" because field 2 is the command name in
  # parentheses.
  local stat
  stat=$(cat /proc/1/stat 2>/dev/null) || return 1
  stat=${stat##*) }
  # shellcheck disable=SC2086
  set -- $stat
  [[ ${20:-} =~ ^[0-9]+$ ]] || return 1
  printf '%s' "${20}"
}

boot_key() {
  # This container boot's identity: the host's boot id plus PID 1's start time.
  # A `docker restart` or recreate changes the start time; a host reboot
  # changes the boot id, and both are needed because a marker in /tmp outlives
  # a host reboot and the container can come back up at the same tick.
  # PD_SUPERVISOR_BOOT_KEY is a test seam.
  if [ -n "${PD_SUPERVISOR_BOOT_KEY:-}" ]; then
    printf '%s' "$PD_SUPERVISOR_BOOT_KEY"
    return
  fi
  local host ticks
  host=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || return 1
  [[ $host =~ ^[0-9a-f-]+$ ]] || return 1
  ticks=$(pid1_start_ticks) || return 1
  printf '%s-%s' "$host" "$ticks"
}

boot_epoch() {
  # When this container's PID 1 started, in whole seconds since the epoch:
  # the host's boot time (btime in /proc/stat, not namespaced) plus PID 1's
  # start ticks over CLK_TCK. The kernel rounds both down, so this is never
  # later than the real start. Fails rather than guessing.
  # PD_HAPPIER_BOOT_EPOCH is a test seam (set but not a number also fails).
  if [ -n "${PD_HAPPIER_BOOT_EPOCH+set}" ]; then
    [[ $PD_HAPPIER_BOOT_EPOCH =~ ^[0-9]{1,15}$ ]] || return 1
    printf '%s' "$((10#$PD_HAPPIER_BOOT_EPOCH))"
    return
  fi
  local btime ticks hz
  btime=$(awk '$1 == "btime" { print $2; exit }' /proc/stat 2>/dev/null)
  [[ $btime =~ ^[0-9]+$ ]] || return 1
  ticks=$(pid1_start_ticks) || return 1
  hz=$(getconf CLK_TCK 2>/dev/null)
  [[ $hz =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s' $((btime + ticks / hz))
}

is_live_daemon() {
  # True when $1 is the PID of a running `happier daemon start-sync` here: a
  # `happier` executable (any directory; happier.mjs and the like too, for the
  # npm copy run by node) followed by "daemon" and "start-sync" as separate
  # arguments, the shape of the real one (<cli>/versions/<v>/happier daemon
  # start-sync). Anything else at that PID is not a daemon to protect.
  [[ $1 =~ ^[1-9][0-9]*$ ]] || return 1
  local -a argv
  local i
  mapfile -d '' -t argv 2>/dev/null <"/proc/$1/cmdline" || return 1
  for ((i = 0; i + 2 < ${#argv[@]}; i++)); do
    [[ ${argv[i]##*/} == happier* ]] && [ "${argv[i + 1]}" = daemon ] \
      && [ "${argv[i + 2]}" = start-sync ] && return 0
  done
  return 1
}

reclaim_file() {
  # Deletes $1 only if it is still the exact file judged stale, identified by
  # $2 ("<inode>:<mtime>"). It is renamed aside first, to a fresh unique name,
  # and checked there, so a file a concurrent start wrote under the same name
  # in between (Happier writes its state by rename and its lock with O_EXCL,
  # both new inodes) is put back instead of deleted. If the name has been taken
  # again meanwhile, the moved file stays at the aside name and says so; it is
  # never overwritten or deleted. Fails when the judged file was not removed.
  local q got
  q=$(mktemp -- "$1.pd-stale.XXXXXX" 2>/dev/null) || return 1
  if ! mv -f -T -- "$1" "$q" 2>/dev/null; then
    rm -f -- "$q"
    return 1
  fi
  got=$(stat -c '%i:%Y' -- "$q" 2>/dev/null)
  if [ "$got" = "$2" ]; then
    rm -f -- "$q"
    return 0
  fi
  # `mv -n` exits 0 on some coreutils even when it skipped, so look, not trust.
  mv -n -T -- "$q" "$1" 2>/dev/null
  [ -e "$q" ] && echo "pocket-dev: happier: left a changed daemon file at $q; $1 was taken again" >&2
  return 1
}

clear_stale_daemon_records() {
  # Removes every Happier daemon record a PREVIOUS container left, so the
  # start that follows does not die on it. Called only when status says the
  # daemon is not running, right before `happier daemon start`.
  #
  # WHY. ~/.happier is in the home mount and outlives a recreate; the PID
  # namespace does not. A daemon killed with its container leaves
  # servers/<profile>/daemon.state.json and its .lock naming a PID from the old
  # namespace, and the new container's boot reuses low PIDs within seconds. When
  # an unrelated process holds that PID, Happier 0.2.17 reports the daemon not
  # running (`daemon status`), but `daemon start` runs stopDaemon(), whose
  # forceKillKnownDaemonPid() refuses to signal a live process it cannot prove is
  # a daemon and throws DaemonStopIncompleteError (process_identity_unverified),
  # so the start-sync child exits 1 and `daemon start` waits out its whole 60 s
  # budget. Measured 2026-11-03 20:47Z: PID 588, two minutes before the daemon
  # and the supervisor came back. Happier's own cleanup (reclaimDeadDaemonPublication)
  # removes these same two files, but only once the PID is free, which after a
  # recreate is luck. Refusing to kill the stranger is right; this keeps it.
  #
  # WHAT COUNTS AS A PREVIOUS CONTAINER'S RECORD: every file of it (state and/or
  # lock) last written more than 2 s before this container's PID 1 started. No
  # process here can have written it, because everything in this PID namespace
  # started after PID 1. boot_epoch is never later than the real start, so the
  # 2 s are slack for a small forward clock step, not for rounding. Every
  # uncertainty keeps the record and the start fails the old, slow way, never
  # the other way round: a record inside the margin (a recreate under ~2 s, or
  # a backward clock step), a state file that does not parse, an unreadable
  # boot time. A record naming a PID that IS a live `happier daemon start-sync`
  # here is kept too, and a profile directory that is a symlink is skipped.
  # Only Happier's record names are touched (daemon.state.json and the
  # per-ring daemon.preview.state.json and daemon.dev.state.json, each with its
  # .lock), never access.key, the broker state or session data. The PID is
  # never signalled. A live daemon is never at stake: status reports it running
  # and this does not run.
  #
  # ASSUMES this container is the only one using this ~/.happier (checked
  # 2026-11-03: no other container mounts it). A daemon in a second container
  # sharing it would be invisible here, and its record could be removed, which
  # Happier's own reclaim would do just the same.
  #
  # DO NOT replace this with `happier doctor clean` (kills every Happier
  # process, sessions included) or with deleting the record unconditionally (a
  # record written in this boot can belong to a daemon that is starting).
  #
  # Arguments are the profile directories to check. The default daemon passes
  # every one under servers/ (a previous container's records are stale in all
  # of them); an extra passes only its own, so supervising it never touches
  # another profile's files.
  local boot dir name rec x m pid pids keep ids i
  boot=$(boot_epoch) || return 0
  for dir in "$@"; do
    dir=${dir%/}
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    for name in daemon.state.json daemon.preview.state.json daemon.dev.state.json; do
      rec="$dir/$name"
      [ -e "$rec" ] || [ -e "$rec.lock" ] || continue
      keep="" pids="" ids=()
      for x in "$rec" "$rec.lock"; do
        [ -e "$x" ] || continue
        m=$(stat -c '%i:%Y' -- "$x" 2>/dev/null)
        if ! [[ $m =~ ^[0-9]+:[0-9]+$ ]] || [ "${m#*:}" -ge $((boot - 2)) ]; then
          keep=1
          break
        fi
        ids+=("$x" "$m")
        if [ "$x" = "$rec" ]; then
          if ! pid=$(node -e 'const p = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).pid; if (!Number.isSafeInteger(p)) process.exit(1); process.stdout.write(String(p));' -- "$x" 2>/dev/null); then
            keep=1  # a state file we cannot read: leave it to Happier
            break
          fi
        elif ! pid=$(tr -d '[:space:]' 2>/dev/null <"$x"); then
          keep=1  # a lock we cannot read could name anything: keep it
          break
        fi
        [[ $pid =~ ^[1-9][0-9]*$ ]] || continue  # no PID, no process to protect
        if is_live_daemon "$pid"; then
          keep=1
          break
        fi
        [[ " $pids " == *" $pid "* ]] || pids="${pids:+$pids }$pid"
      done
      # Both files gone between the glance above and the checks: nothing to do.
      [ -n "$keep" ] || [ "${#ids[@]}" -eq 0 ] && continue
      # State before lock, and stop at the first that changed, so a record is
      # never split into a kept state file and a deleted lock.
      for ((i = 0; i < ${#ids[@]}; i += 2)); do
        reclaim_file "${ids[i]}" "${ids[i + 1]}" || { keep=1; break; }
      done
      if [ -n "$keep" ]; then
        echo "pocket-dev: happier: could not clear the daemon record $rec; it changed while being checked" >&2
      else
        echo "pocket-dev: happier: cleared a daemon record from a previous container ($rec, PID ${pids:-none}); that PID belongs to another process now" >&2
      fi
    done
  done
}

run_resume() {
  # The background half: resume-self, retried after a failure, at most 3 runs.
  # Exit 0 is resumed, already running or skipped; the outcome line says which.
  # One skip is NOT final: "another resume-self is running" means a hand-started
  # run holds the lock, and that run can wait up to its own 600 s timeout and
  # then fail. So a lock skip is retried without using up a run, for up to
  # RESUME_LOCK_WAIT (720) s from the FIRST skip of a streak (a holder that took the lock late in
  # this worker's life gets its whole window), and only then counts as a
  # failure. Returns 1 after giving up.
  local attempt=1 rc line out lock_until=""
  while :; do
    out=$(timeout 700 python3 -I "$RESUME_SCRIPT" resume-self --timeout 600 </dev/null 2>&1)
    rc=$?
    while IFS= read -r line; do echo "pocket-dev: supervisor-resume: $line" >&2; done <<<"$out"
    if [ "$rc" = 0 ] && [[ $out == *"another resume-self is running"* ]]; then
      [ -z "$lock_until" ] && lock_until=$((SECONDS + RESUME_LOCK_WAIT))
      if [ "$SECONDS" -lt "$lock_until" ]; then
        sleep "$RESUME_RETRY"
        continue
      fi
    elif [ "$rc" = 0 ]; then
      return 0
    fi
    lock_until=""
    [ "$attempt" -ge 3 ] && break
    echo "pocket-dev: supervisor-resume: run $attempt exited $rc; retrying in ${RESUME_RETRY}s" >&2
    attempt=$((attempt + 1))
    sleep "$RESUME_RETRY"
  done
  echo "pocket-dev: supervisor-resume: gave up after 3 runs (last exit $rc); by hand: python3 -I $RESUME_SCRIPT resume-self" >&2
  return 1
}

resume_supervisor() {
  # Called on every pass that finds the daemon up; does anything at most once
  # per process, and launches resume-self at most once per container boot.
  # Only the default daemon's pass resumes it: the supervisor is a session on
  # the active profile's relay, and an extra profile's daemon coming up says
  # nothing about that one.
  [ -n "$SCOPE" ] && return 0
  [ -n "$resume_checked" ] && return 0
  resume_checked=1
  [ "${PD_SUPERVISOR_RESUME:-1}" = "0" ] && return 0
  if [ "$(id -u)" = "0" ]; then
    # The supervisor is claude's; a root run would leave root-owned state in its home.
    echo "pocket-dev: supervisor-resume: running as root, not claude; skipped" >&2
    return 0
  fi
  if [ ! -f "$RESUME_SCRIPT" ]; then
    echo "pocket-dev: supervisor-resume: no supervisor skill ($RESUME_SCRIPT); skipped" >&2
    return 0
  fi
  local key
  if ! key=$(boot_key) || [ -z "$key" ]; then
    echo "pocket-dev: supervisor-resume: cannot tell this boot from /proc; skipped" >&2
    return 0
  fi
  if ! { mkdir -p "$RESUME_DIR" && mkdir "$RESUME_DIR/$key"; } 2>/dev/null; then
    if [ -d "$RESUME_DIR/$key" ]; then
      echo "pocket-dev: supervisor-resume: already launched this boot ($RESUME_DIR/$key); skipped" >&2
      return 0
    fi
    # The marker only stops a second loop in the same boot from repeating the
    # run; resume-self's own lock and its "already running" check make one
    # extra run harmless, so an unwritable marker is not a reason to leave the
    # supervisor down.
    echo "pocket-dev: supervisor-resume: cannot write the marker $RESUME_DIR/$key; resuming without it" >&2
  fi
  echo "pocket-dev: supervisor-resume: daemon is up; resuming the supervisor in the background" >&2
  run_resume &
}

read_state() {
  # Prints "<authenticated> <running> <converged> <daemon-version> <cli-version>
  # <active-profile>" with true/false words, or "unknown". <converged> is true,
  # false or unknown: unknown (an older CLI without runtimeConvergence, or a
  # service-owned daemon, which its service restarts) never triggers a restart.
  # The versions are only for the log and the once-per-pair rule; anything not
  # a plain version is "-". <active-profile> is the profile the answer is about
  # (server.activeServerId), "-" when absent or not a plain id. For an extra,
  # an answer about any other profile is "unknown": then --server did not take,
  # and acting on it would act on the wrong daemon.
  local out
  if ! out=$(set -o pipefail; timeout 30 "${HP[@]}" daemon status --json 2>/dev/null); then
    echo unknown
    return
  fi
  # SC2016: the single quotes are deliberate; ${a} below is a JS template, not bash.
  # shellcheck disable=SC2016
  printf '%s' "$out" | PD_EXPECT_PROFILE="$SCOPE" PD_PROFILE_RE="$PROFILE_RE" node -e '
    let s = "";
    process.stdin.on("data", (d) => { s += d; }).on("end", () => {
      try {
        const j = JSON.parse(s);
        const a = j && j.auth && j.auth.authenticated;
        const r = j && j.daemon && j.daemon.running;
        if (typeof a !== "boolean" || typeof r !== "boolean") throw new Error("shape");
        const id = j.server && j.server.activeServerId;
        const want = process.env.PD_EXPECT_PROFILE;
        if (want && id !== want) throw new Error("profile");
        const p = typeof id === "string" && new RegExp(process.env.PD_PROFILE_RE).test(id) ? id : "-";
        const m = j.runtimeConvergence && j.runtimeConvergence.cliVersionMatches;
        const service = j.daemon && j.daemon.serviceManaged === true;
        const c = typeof m === "boolean" && !service ? String(m) : "unknown";
        const v = (x) => (typeof x === "string" && /^[0-9A-Za-z._+-]+$/.test(x) ? x : "-");
        const dv = v(j.daemon && j.daemon.startedWithCliVersion);
        const cv = v(j.cliUpdate && j.cliUpdate.currentVersion);
        process.stdout.write(`${a} ${r} ${c} ${dv} ${cv} ${p}`);
      } catch {
        process.stdout.write("unknown");
      }
    });'
}

supervise_profile() {
  # One pass for one profile: SCOPE is "" for the default daemon or an extra's
  # id. Everything that differs between the two is named here: which
  # credential counts, which records may be cleared, and that only the default
  # daemon resumes the supervisor.
  local state pair signed_out
  if [ -n "$SCOPE" ]; then HP=(happier --server "$SCOPE"); else HP=(happier); fi
  signed_out="not signed in to server profile $SCOPE (run 'happier --server $SCOPE auth login'); its daemon is not started"
  [ -z "$SCOPE" ] && signed_out="not signed in to a Happier server (run 'happier auth login'); daemon not started"
  if [ -z "$SCOPE" ]; then
    ACTIVE="-"
    if ! compgen -G "$HAPPIER_HOME/servers/*/access.key" >/dev/null; then
      # Never signed in: nothing to start, and no CLI call is worth making.
      say no-credential "no Happier sign-in yet; the daemon starts on the first check after 'happier auth login'"
      return
    fi
  else
    if [ -L "$HAPPIER_HOME/servers/$SCOPE" ]; then
      # A symlinked profile can be another profile's files under a second name,
      # the active one's included; the id check below cannot see that.
      say symlink "server profile $SCOPE is a symlink, so it may be another profile's daemon; leaving it alone"
      return
    fi
    if [ ! -f "$HAPPIER_HOME/servers/$SCOPE/access.key" ]; then
      say signed-out "$signed_out"
      return
    fi
    if [ "$ACTIVE" = "-" ]; then
      say no-active "could not tell which profile is active this pass; leaving profile $SCOPE alone until it can"
      return
    fi
    if [ "$ACTIVE" = "$SCOPE" ]; then
      say is-active "profile $SCOPE is the active profile, so the default daemon is its daemon; nothing extra to do"
      return
    fi
  fi
  state=$(read_state)
  # The active profile, learned from the default daemon's own status. Extras
  # are checked against it before anything is done to them.
  if [ -z "$SCOPE" ] && [ "$state" != unknown ]; then
    ACTIVE=${state##* }
  fi
  case "$state" in
    "true true false "*)
      # shellcheck disable=SC2086
      set -- $state
      pair="$4>$5"
      if ! newer "$5" "$4"; then
        # Never a downgrade: when the managed launcher is missing or dangling,
        # PATH finds the image's older npm fallback, and moving a newer daemon
        # onto it would undo the update. An unparseable version proves nothing.
        say "not-newer:$pair" "daemon runs CLI $4 and PATH has $5, which is not newer; leaving the daemon"
        resume_supervisor  # the daemon still runs, on its current CLI
      elif [ "$pair" = "${restarted_for[${SCOPE:-.}]:-}" ]; then
        say "stuck:$pair" "daemon still runs CLI $4 after a restart onto $5; not restarting again"
        resume_supervisor  # the daemon still runs, on its current CLI
      elif ! timeout 90 "${HP[@]}" daemon stop >/dev/null 2>&1; then
        # Not recorded as done: a transient failure is retried next pass.
        say "stop-failed:$pair" "could not stop the daemon (CLI $4) to move it onto CLI $5; retrying every ${INTERVAL}s"
        resume_supervisor  # the daemon still runs, on its current CLI
      else
        restarted_for[${SCOPE:-.}]="$pair"
        if timeout 90 "${HP[@]}" daemon start >/dev/null 2>&1; then
          say "restarted:$pair" "daemon restarted onto CLI $5 (was $4)"
          resume_supervisor
        else
          say start-failed "daemon is not running and did not start; retrying every ${INTERVAL}s"
        fi
      fi
      ;;
    "true true "*)
      say running "daemon running"
      resume_supervisor
      ;;
    "true false "*)
      if [ -z "$SCOPE" ]; then
        clear_stale_daemon_records "$HAPPIER_HOME"/servers/*/
      else
        clear_stale_daemon_records "$HAPPIER_HOME/servers/$SCOPE/"
      fi
      if timeout 90 "${HP[@]}" daemon start >/dev/null 2>&1; then
        say running "daemon started"
        resume_supervisor
      else
        say start-failed "daemon is not running and did not start; retrying every ${INTERVAL}s"
      fi
      ;;
    "false "*)
      say signed-out "$signed_out"
      ;;
    *)
      say unknown "could not read daemon status; retrying every ${INTERVAL}s"
      ;;
  esac
}

# The extra profiles, validated once: a malformed id is reported once and never
# reaches the CLI or a path, and a repeated one is supervised once.
EXTRAS=()
# read -a splits on whitespace without globbing, which an unquoted expansion
# would do; -d '' reads past newlines (a plain read stops at the first one), and
# it then exits 1 at the end of input, which is expected. CR counts as
# whitespace, so a value pasted with Windows line endings is not silently lost.
IFS=$' \t\r\n' read -r -d '' -a extra_ids <<<"${PD_HAPPIER_EXTRA_SERVERS:-}" || :
for id in "${extra_ids[@]}"; do
  if ! [[ $id =~ $PROFILE_RE ]]; then
    echo "pocket-dev: happier: ignoring PD_HAPPIER_EXTRA_SERVERS entry '$id': not a plain profile id" >&2
    continue
  fi
  [[ " ${EXTRAS[*]} " == *" $id "* ]] || EXTRAS+=("$id")
done
# Happier lets these variables choose the server and the daemon's state path,
# and HAPPIER_DAEMON_LIFECYCLE_SCOPE_ID outranks --server for the state path
# (0.2.20, persistence: daemonStateFile). With one inherited, `--server <id>`
# could read one profile's status and start or stop another's daemon, so
# extras are not supervised at all. Nothing in the container sets them
# (checked 2026-11-05: this loop's environment carries no HAPPIER_ variable);
# the CLI puts them into the environment of a daemon it starts, not into ours.
for v in HAPPIER_DAEMON_LIFECYCLE_SCOPE_ID HAPPIER_ACTIVE_SERVER_ID HAPPIER_SERVER_URL; do
  if [ "${#EXTRAS[@]}" -gt 0 ] && [ -n "${!v-}" ]; then
    echo "pocket-dev: happier: $v is set in this environment, so --server cannot be trusted to pick the daemon; not supervising PD_HAPPIER_EXTRA_SERVERS (${EXTRAS[*]})" >&2
    EXTRAS=()
  fi
done

while :; do
  SCOPE=""
  supervise_profile
  for SCOPE in "${EXTRAS[@]}"; do
    supervise_profile
  done
  SCOPE=""
  [ "$ONCE" = "1" ] && exit 0
  sleep "$INTERVAL"
done
